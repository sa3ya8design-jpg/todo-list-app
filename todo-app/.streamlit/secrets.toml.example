# このファイルを secrets.toml という名前でコピーして値を埋めてください。
# secrets.toml には秘密鍵が入るため、Gitで管理する場合は必ず .gitignore に追加すること。
# サーバーで公開する場合は、ホスティング側のSecrets設定にこのファイルと同じ内容を貼り付ける。

# スプレッドシートURLの /d/ と /edit の間にあるID
spreadsheet_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Cloud のサービスアカウント鍵（ダウンロードしたJSON）の内容をそのまま転記する
# ※スプレッドシートを client_email のアドレスに「編集者」として共有するのを忘れずに
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
